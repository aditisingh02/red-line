# Redline configuration — copy to .env and fill in. .env is gitignored.

# Primary LLM-judge scorer (Fireworks AI, OpenAI-compatible). If unset, regex scorer is used.
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/gpt-oss-120b
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# Alternate LLM-judge scorer (Groq, OpenAI-compatible). Used only if FIREWORKS_API_KEY is unset.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional alternate judge (used only if FIREWORKS_API_KEY and GROQ_API_KEY are unset and this is set)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages

# Default model for the OpenAI-compatible target adapter (override per-scan
# with an 'X-Model: ...' auth header)
OPENAI_MODEL=gpt-3.5-turbo

# Runner
REDLINE_REQUEST_TIMEOUT=10        # hard per-request timeout (seconds)
REDLINE_MAX_RETRIES=3

# Storage
REDLINE_DB_PATH=redline.db

# Demo
REDLINE_DEMO_MODE=false
REDLINE_MAX_TESTS=

# Observability (both optional — absent backend is a no-op)
REDLINE_METRICS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=          # e.g. http://localhost:4318/v1/traces

# GitHub App / Actions integration
GITHUB_TOKEN=                         # for private-repo clone + PR comments
GITHUB_WEBHOOK_SECRET=                # HMAC secret for /api/github/webhook

# GitHub OAuth — user login (works for both GitHub OAuth Apps and GitHub Apps).
# Leave empty to disable the login feature; the rest of the app still works.
# Register an App at https://github.com/settings/apps (or oauth/applications),
# set the callback to <REDIRECT_URI> below, and paste the client id + secret.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:5173/api/auth/github/callback
AUTH_POST_LOGIN_REDIRECT=http://localhost:5173/dashboard
