# Redline configuration — copy to .env and fill in. .env is gitignored.

# Primary LLM-judge scorer (Groq, OpenAI-compatible). If unset, regex scorer is used.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional alternate judge (used only if GROQ_API_KEY is unset and this is set)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Runner
REDLINE_REQUEST_TIMEOUT=10        # hard per-request timeout (seconds)
REDLINE_MAX_RETRIES=3

# Storage
REDLINE_DB_PATH=redline.db

# Demo
REDLINE_DEMO_MODE=false
REDLINE_MAX_TESTS=
